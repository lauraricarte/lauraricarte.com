  // ===== HEARTMATE POPUP (Slide 24) =====
  const heartmatePopup = document.getElementById('heartmate-popup');
  const closeHeartmateBtn = document.getElementById('close-heartmate');
  const heartmateCard = heartmatePopup?.querySelector('.heartmate-card') as HTMLElement;
