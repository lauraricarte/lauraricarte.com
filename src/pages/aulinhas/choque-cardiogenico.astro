  // Botões para abrir PAPi
  document.querySelectorAll('.btn-show-papi').forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      showPapi();
    });
  });

  // Handler do Escape para todos os popups
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      if (shockTablePopup?.classList.contains('show')) {
        hideShockTable();
      }
      if (papiPopup?.classList.contains('show')) {
        hidePapi();
      }
      if (scaiPopup?.classList.contains('show')) {
        hideScai();
      }
      if (receptorsPopup?.classList.contains('show')) {
        hideReceptors();
      }
      if (heartmatePopup?.classList.contains('show')) {
        hideHeartmate();
      }
      if (amiCsPopup?.classList.contains('show')) {
        hideAmiCs();
      }
      if (hfCsPopup?.classList.contains('show')) {
        hideHfCs();
      }
      if (reassessmentPopup?.classList.contains('show')) {
        hideReassessment();
      }
      if (biaImgPopup?.classList.contains('show')) {
        hideBiaImg();
      }
      if (impellaImgPopup?.classList.contains('show')) {
        hideImpellaImg();
      }
    }
  });

  // Initialize
  updateSlide();
</script>
