  // ===== BOTÕES DO SLIDE 12 (E SLIDE 2) =====
  // Botões para abrir tabela de tipos de choque
  document.querySelectorAll('.btn-show-shock-table').forEach(btn => {
    btn.addEventListener('click', (e) => {
