  // ===== IMPELLA IMAGE POPUP (Slide 24) =====
  const impellaImgPopup = document.getElementById('impella-img-popup');
  const closeImpellaImgBtn = document.getElementById('close-impella-img');
  const impellaImgCard = impellaImgPopup?.querySelector('.device-img-card') as HTMLElement;
