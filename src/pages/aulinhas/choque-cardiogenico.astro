  });

  // ===== AMI-CS POPUP (Slide 26) =====
  const amiCsPopup = document.getElementById('ami-cs-popup');
  const closeAmiCsBtn = document.getElementById('close-ami-cs');
  const amiCsCard = amiCsPopup?.querySelector('.cs-management-card') as HTMLElement;
  const amiCsThumb = document.getElementById('ami-cs-thumb');

