---
import "../../styles/base.css";
import Layout from "../../layouts/Layout.astro";
---

<Layout
  title="Choque Cardiogênico - Aula para Acadêmicos de Medicina"
  description="Apresentação didática sobre avaliação e manejo do choque cardiogênico baseada nas diretrizes ACC 2025 e NEJM 2026"
  noindex={true}
>
  <main id="main-presentation" class="presentation-dark min-h-screen overflow-hidden">
    <!-- Slide Container -->
    <div id="presentation" class="relative w-full h-screen">

      <!-- Progress Bar -->
      <div class="fixed top-0 left-0 w-full h-1 bg-neutral-800 z-50">
        <div id="progress-bar" class="h-full bg-gradient-to-r from-red-500 to-red-600 transition-all duration-300" style="width: 0%"></div>
      </div>

      <!-- Back to Aulinhas -->
      <a href="/aulinhas" class="fixed top-3 md:top-6 left-3 md:left-6 z-50 p-2 md:p-3 bg-neutral-900/90 backdrop-blur-sm hover:bg-neutral-700 rounded-full border border-neutral-700 transition-colors text-rose-300 hover:text-rose-200">
        <svg class="w-4 h-4 md:w-5 md:h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
      </a>

      <!-- Navigation -->
      <div class="fixed bottom-4 md:bottom-6 left-1/2 -translate-x-1/2 z-50 flex items-center gap-2 md:gap-4 bg-neutral-900/90 backdrop-blur-sm px-4 md:px-6 py-2 md:py-3 rounded-full border border-neutral-700">
        <button id="prev-btn" class="p-1.5 md:p-2 hover:bg-neutral-700 rounded-full transition-colors disabled:opacity-30" disabled>
          <svg class="w-5 h-5 md:w-6 md:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
          </svg>
        </button>
        <div class="flex items-center gap-1 text-xs md:text-sm font-medium">
          <input id="slide-input" type="text" value="1" class="w-6 md:w-8 bg-transparent text-center border-b border-transparent hover:border-neutral-500 focus:border-red-400 focus:outline-none transition-colors" />
          <span>/ <span id="total-slides">38</span></span>
        </div>
        <button id="next-btn" class="p-1.5 md:p-2 hover:bg-neutral-700 rounded-full transition-colors">
          <svg class="w-5 h-5 md:w-6 md:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </button>
      </div>

      <!-- Theme Toggle Button -->
      <button id="theme-btn" class="fixed top-3 md:top-6 right-14 md:right-20 z-50 p-2 md:p-3 bg-neutral-900/90 backdrop-blur-sm hover:bg-neutral-700 rounded-full border border-neutral-700 transition-colors" title="Alternar tema">
        <svg id="theme-icon-dark" class="w-4 h-4 md:w-5 md:h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/>
        </svg>
        <svg id="theme-icon-light" class="w-4 h-4 md:w-5 md:h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/>
        </svg>
      </button>

      <!-- Fullscreen Button -->
      <button id="fullscreen-btn" class="fixed top-3 md:top-6 right-3 md:right-6 z-50 p-2 md:p-3 bg-neutral-900/90 backdrop-blur-sm hover:bg-neutral-700 rounded-full border border-neutral-700 transition-colors">
        <svg class="w-4 h-4 md:w-5 md:h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"/>
        </svg>
      </button>

      <!-- SLIDES -->
      <div id="slides-container" class="w-full h-full">

        <!-- Slide 1: Titulo -->
        <section class="slide active flex flex-col items-center justify-center h-full px-8 text-center" data-slide="1">
          <div class="max-w-5xl mx-auto">
            <div class="inline-flex items-center gap-2 px-4 py-2 bg-red-500/20 border border-red-500/30 rounded-full text-red-400 text-sm font-medium mb-8">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" clip-rule="evenodd"/>
              </svg>
              Cardiologia de Emergência
            </div>
            <h1 class="text-4xl md:text-7xl pb-2 font-bold mb-6 bg-gradient-to-r from-white via-red-100 to-red-200 bg-clip-text text-transparent">
              Choque Cardiogênico
            </h1>
            <p class="text-xl md:text-2xl text-neutral-300 mb-8">
              Avaliação e Manejo Baseado em Evidências
            </p>
            <div class="flex flex-wrap justify-center gap-4 text-sm text-neutral-400">
              <span class="px-3 py-1 bg-neutral-800 rounded-full">ACC Expert Consensus 2025</span>
              <span class="px-3 py-1 bg-neutral-800 rounded-full">NEJM Review 2026</span>
            </div>
            <div class="mt-12 pt-8 border-t border-neutral-800">
              <p class="text-neutral-500 text-sm">Apresentado por Laura Ricarte <br/> Residente de Clinica Medica UFRR (R2) </p>
            </div>
          </div>
        </section>

        <!-- Slide 2: Tipos de Choque - Tabela Comparativa -->
        <section class="slide flex flex-col items-center justify-start md:justify-center h-full px-2 md:px-4 py-14 md:py-8" data-slide="2">
          <div class="max-w-6xl mx-auto w-full">
            <h2 class="text-xl md:text-3xl font-bold mb-4 md:mb-6 text-center">Tipos de Choque: Perfil Hemodinâmico</h2>
            <div class="overflow-x-auto shock-table-container rounded-2xl">
              <table class="shock-table w-full text-sm">
                <thead>
                  <tr>
                    <th class="px-4 py-3 text-left font-semibold">Tipo de Choque</th>
                    <th class="px-3 py-3 text-center font-semibold">PVC</th>
                    <th class="px-3 py-3 text-center font-semibold">POAP</th>
                    <th class="px-3 py-3 text-center font-semibold">DC/IC</th>
                    <th class="px-3 py-3 text-center font-semibold">RVS</th>
                    <th class="px-3 py-3 text-center font-semibold">SvO₂</th>
                    <th class="px-4 py-3 text-left font-semibold">Fisiopatologia</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="shock-row">
                    <td class="px-4 py-3 font-medium">Hipovolêmico</td>
                    <td class="px-3 py-3 text-center"><span class="arrow-down">↓</span></td>
                    <td class="px-3 py-3 text-center"><span class="arrow-down">↓</span></td>
                    <td class="px-3 py-3 text-center"><span class="arrow-down">↓</span></td>
                    <td class="px-3 py-3 text-center"><span class="arrow-up">↑</span></td>
                    <td class="px-3 py-3 text-center"><span class="arrow-down">↓</span></td>
                    <td class="px-4 py-3 text-xs opacity-80">Baixa pré-carga → baixo débito</td>
                  </tr>
                  <tr class="shock-row-highlight">
                    <td class="px-4 py-3 font-bold">Cardiogênico</td>
                    <td class="px-3 py-3 text-center"><span class="arrow-up">↑</span></td>
                    <td class="px-3 py-3 text-center"><span class="arrow-up">↑↑</span></td>
                    <td class="px-3 py-3 text-center"><span class="arrow-down">↓↓</span></td>
                    <td class="px-3 py-3 text-center"><span class="arrow-up">↑</span></td>
                    <td class="px-3 py-3 text-center"><span class="arrow-down">↓</span></td>
                    <td class="px-4 py-3 text-xs font-medium">Falência de bomba → congestão</td>
                  </tr>
                  <tr class="shock-row">
                    <td class="px-4 py-3 font-medium">Distributivo (séptico)</td>
                    <td class="px-3 py-3 text-center"><span class="arrow-neutral">↓/N</span></td>
                    <td class="px-3 py-3 text-center"><span class="arrow-neutral">↓/N</span></td>
                    <td class="px-3 py-3 text-center"><span class="arrow-up">↑</span></td>
                    <td class="px-3 py-3 text-center"><span class="arrow-down">↓↓</span></td>
                    <td class="px-3 py-3 text-center"><span class="arrow-up">↑</span></td>
                    <td class="px-4 py-3 text-xs opacity-80">Vasoplegia + shunt</td>
                  </tr>
                  <tr class="shock-row">
                    <td class="px-4 py-3 font-medium">Distributivo tardio</td>
                    <td class="px-3 py-3 text-center"><span class="arrow-neutral">↓/N</span></td>
                    <td class="px-3 py-3 text-center"><span class="arrow-neutral">↓/N</span></td>
                    <td class="px-3 py-3 text-center"><span class="arrow-down">↓</span></td>
                    <td class="px-3 py-3 text-center"><span class="arrow-down">↓</span></td>
                    <td class="px-3 py-3 text-center"><span class="arrow-down">↓</span></td>
                    <td class="px-4 py-3 text-xs opacity-80">Depressão miocárdica séptica</td>
                  </tr>
                  <tr class="shock-row">
                    <td class="px-4 py-3 font-medium">Obstrutivo – TEP</td>
                    <td class="px-3 py-3 text-center"><span class="arrow-up">↑↑</span></td>
                    <td class="px-3 py-3 text-center"><span class="arrow-neutral">↓/N</span></td>
                    <td class="px-3 py-3 text-center"><span class="arrow-down">↓</span></td>
                    <td class="px-3 py-3 text-center"><span class="arrow-up">↑</span></td>
                    <td class="px-3 py-3 text-center"><span class="arrow-down">↓</span></td>
                    <td class="px-4 py-3 text-xs opacity-80">Falência VD → baixo enchimento VE</td>
                  </tr>
                  <tr class="shock-row">
                    <td class="px-4 py-3 font-medium">Obstrutivo – Tamponamento</td>
                    <td class="px-3 py-3 text-center"><span class="arrow-up">↑↑</span></td>
                    <td class="px-3 py-3 text-center"><span class="arrow-up">↑</span></td>
                    <td class="px-3 py-3 text-center"><span class="arrow-down">↓</span></td>
                    <td class="px-3 py-3 text-center"><span class="arrow-up">↑</span></td>
                    <td class="px-3 py-3 text-center"><span class="arrow-down">↓</span></td>
                    <td class="px-4 py-3 text-xs opacity-80">Restrição diastólica global</td>
                  </tr>
                  <tr class="shock-row">
                    <td class="px-4 py-3 font-medium">Neurogênico</td>
                    <td class="px-3 py-3 text-center"><span class="arrow-down">↓</span></td>
                    <td class="px-3 py-3 text-center"><span class="arrow-down">↓</span></td>
                    <td class="px-3 py-3 text-center"><span class="arrow-down">↓</span></td>
                    <td class="px-3 py-3 text-center"><span class="arrow-down">↓↓</span></td>
                    <td class="px-3 py-3 text-center"><span class="arrow-neutral">N/↑</span></td>
                    <td class="px-4 py-3 text-xs opacity-80">Perda de tônus simpático</td>
                  </tr>
                </tbody>
              </table>
            </div>
            <div class="mt-5 flex flex-wrap gap-3 md:gap-6 justify-center items-center text-xs">
              <span class="flex items-center gap-1.5"><span class="arrow-up text-base">↑</span> Aumentado</span>
              <span class="flex items-center gap-1.5"><span class="arrow-down text-base">↓</span> Diminuído</span>
              <span class="opacity-60 hidden md:inline">N = Normal</span>
              <button id="toggle-normal-values" class="normal-values-btn ml-2 md:ml-4 px-3 md:px-4 py-2 rounded-full text-xs font-medium transition-all flex items-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
                Valores Normais
              </button>
              <button id="toggle-ventricular-table" class="ventricular-btn px-4 py-2 rounded-full text-xs font-medium transition-all flex items-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
                </svg>
                Perfil VE / VD
              </button>
            </div>
          </div>
        </section>

        <!-- Slide 3: Cateter de Swan-Ganz -->
        <section class="slide flex flex-col items-center justify-center h-full px-4 py-16" data-slide="3">
          <div class="max-w-7xl mx-auto w-full">
            <h2 class="text-2xl md:text-3xl font-bold mb-6 text-center bg-gradient-to-r from-amber-200 to-orange-300 bg-clip-text text-transparent">Cateter de Swan-Ganz</h2>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-6">
              <!-- Anatomia -->
              <div class="bg-white rounded-2xl p-3 shadow-lg">
                <img src="/swan-ganz-anatomia.png" alt="Anatomia do Swan-Ganz" class="w-full h-auto rounded-lg" />
              </div>
              <!-- Curvas -->
              <div class="bg-white rounded-2xl p-3 shadow-lg">
                <img src="/swan-ganz-curvas.png" alt="Curvas do Swan-Ganz" class="w-full h-auto rounded-lg" />
              </div>
              <!-- Inserção -->
              <div class="bg-white rounded-2xl p-3 shadow-lg">
                <img src="/swan-ganz-insercao.png" alt="Inserção do Swan-Ganz" class="w-full h-auto rounded-lg" />
              </div>
            </div>
            <p class="text-center text-neutral-400 text-sm mt-4">Monitorização hemodinâmica invasiva para avaliação do choque cardiogênico</p>
          </div>
        </section>

        <!-- Slide 4: Objetivos -->
        <section class="slide flex flex-col items-center justify-center h-full px-8" data-slide="4">
          <div class="max-w-4xl mx-auto w-full">
            <h2 class="text-4xl font-bold mb-12 text-center">Objetivos de Aprendizagem</h2>
            <div class="grid md:grid-cols-2 gap-6">
              <div class="bg-neutral-900/50 border border-neutral-700 rounded-2xl p-6 hover:border-red-500/50 transition-colors">
                <div class="w-12 h-12 bg-red-500/20 rounded-xl flex items-center justify-center mb-4">
                  <span class="text-2xl font-bold text-red-400">1</span>
                </div>
                <h3 class="text-lg font-semibold mb-2">Reconhecer Precocemente</h3>
                <p class="text-neutral-400 text-sm">Identificar sinais e sintomas do choque cardiogênico utilizando o mnemônico SUSPECT CS</p>
              </div>
              <div class="bg-neutral-900/50 border border-neutral-700 rounded-2xl p-6 hover:border-red-500/50 transition-colors">
                <div class="w-12 h-12 bg-red-500/20 rounded-xl flex items-center justify-center mb-4">
                  <span class="text-2xl font-bold text-red-400">2</span>
                </div>
                <h3 class="text-lg font-semibold mb-2">Classificar a Gravidade</h3>
                <p class="text-neutral-400 text-sm">Aplicar a classificação SCAI (A-E) para estratificação de risco</p>
              </div>
              <div class="bg-neutral-900/50 border border-neutral-700 rounded-2xl p-6 hover:border-red-500/50 transition-colors">
                <div class="w-12 h-12 bg-red-500/20 rounded-xl flex items-center justify-center mb-4">
                  <span class="text-2xl font-bold text-red-400">3</span>
                </div>
                <h3 class="text-lg font-semibold mb-2">Manejo Farmacológico</h3>
                <p class="text-neutral-400 text-sm">Compreender inotrópicos, vasopressores e suas indicações</p>
              </div>
              <div class="bg-neutral-900/50 border border-neutral-700 rounded-2xl p-6 hover:border-red-500/50 transition-colors">
                <div class="w-12 h-12 bg-red-500/20 rounded-xl flex items-center justify-center mb-4">
                  <span class="text-2xl font-bold text-red-400">4</span>
                </div>
                <h3 class="text-lg font-semibold mb-2">Suporte Mecânico</h3>
                <p class="text-neutral-400 text-sm">Conhecer dispositivos de assistência circulatória temporária</p>
              </div>
            </div>
          </div>
        </section>

        <!-- Slide 5: Definição -->
        <section class="slide flex flex-col items-center justify-center h-full px-8" data-slide="5">
          <div class="max-w-5xl mx-auto w-full">
            <h2 class="text-4xl font-bold mb-8 text-center">O que e Choque Cardiogênico?</h2>
            <div class="bg-gradient-to-br from-red-500/10 to-red-600/5 border border-red-500/20 rounded-3xl p-8 mb-8">
              <p class="text-xl md:text-2xl text-center leading-relaxed">
                <span class="text-red-400 font-semibold">Distúrbio cardíaco</span> que resulta em evidência
                <span class="text-red-400 font-semibold">clínica e bioquímica</span> de
                <span class="text-red-400 font-semibold">hipoperfusão tecidual sustentada</span>,
                independente da pressão arterial subjacente.
              </p>
              <p class="text-center text-neutral-500 text-sm mt-4">— SHARC (Shock Academic Research Consortium), 2023</p>
            </div>
            <div class="grid md:grid-cols-3 gap-4">
              <div class="bg-neutral-900/50 rounded-xl p-5 text-center">
                <div class="text-3xl font-bold text-red-400 mb-2">30-50%</div>
                <p class="text-neutral-400 text-sm">Mortalidade em 30 dias</p>
              </div>
              <div class="bg-neutral-900/50 rounded-xl p-5 text-center">
                <div class="text-3xl font-bold text-red-400 mb-2">~50%</div>
                <p class="text-neutral-400 text-sm">Mortalidade em 1 ano</p>
              </div>
              <div class="bg-neutral-900/50 rounded-xl p-5 text-center">
                <div class="text-3xl font-bold text-red-400 mb-2">#1</div>
                <p class="text-neutral-400 text-sm">Causa de morte no IAM hospitalizado</p>
              </div>
            </div>
          </div>
        </section>

        <!-- Slide 4: Critérios Diagnósticos -->
        <section class="slide flex flex-col items-center justify-center h-full px-8" data-slide="6">
          <div class="max-w-5xl mx-auto w-full">
            <h2 class="text-4xl font-bold mb-10 text-center">Critérios Diagnósticos</h2>
            <div class="grid md:grid-cols-2 gap-6">
              <div class="bg-neutral-900/50 border-2 border-red-500/30 rounded-2xl p-6">
                <h3 class="text-xl font-semibold mb-5 flex items-center gap-3">
                  <span class="w-10 h-10 bg-red-500 rounded-xl flex items-center justify-center text-lg font-bold">1</span>
                  Hipotensão Sustentada
                </h3>
                <ul class="space-y-3 text-neutral-300">
                  <li class="flex items-start gap-3">
                    <svg class="w-5 h-5 text-red-400 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                    </svg>
                    <span>PAS &lt;90 mmHg por &gt;30 min</span>
                  </li>
                  <li class="flex items-start gap-3">
                    <svg class="w-5 h-5 text-red-400 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                    </svg>
                    <span>PAM &lt;65 mmHg</span>
                  </li>
                  <li class="flex items-start gap-3">
                    <svg class="w-5 h-5 text-red-400 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                    </svg>
                    <span>Queda &gt;30 mmHg do basal</span>
                  </li>
                  <li class="flex items-start gap-3">
                    <svg class="w-5 h-5 text-red-400 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                    </svg>
                    <span>Necessidade de DVA para manter PAS &gt;90</span>
                  </li>
                </ul>
              </div>
              <div class="bg-neutral-900/50 border-2 border-red-500/30 rounded-2xl p-6">
                <h3 class="text-xl font-semibold mb-5 flex items-center gap-3">
                  <span class="w-10 h-10 bg-red-500 rounded-xl flex items-center justify-center text-lg font-bold">2</span>
                  Hipoperfusão Orgânica
                </h3>
                <ul class="space-y-3 text-neutral-300">
                  <li class="flex items-start gap-3">
                    <svg class="w-5 h-5 text-red-400 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                    </svg>
                    <span>Lactato &gt;2 mmol/L</span>
                  </li>
                  <li class="flex items-start gap-3">
                    <svg class="w-5 h-5 text-red-400 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
