</style>

<script>
  const slides = document.querySelectorAll('.slide');
  const prevBtn = document.getElementById('prev-btn') as HTMLButtonElement;
  const nextBtn = document.getElementById('next-btn') as HTMLButtonElement;
  const slideInput = document.getElementById('slide-input') as HTMLInputElement;
  const totalSlidesSpan = document.getElementById('total-slides');
  const progressBar = document.getElementById('progress-bar');
  const fullscreenBtn = document.getElementById('fullscreen-btn');
  const presentation = document.getElementById('presentation');

  const totalSlides = slides.length;

  // Recupera o slide da URL hash ou começa do 1
  function getSlideFromHash() {
    const hash = window.location.hash;
    const match = hash.match(/^#slide-(\d+)$/);
    if (match) {
      const num = parseInt(match[1], 10);
      if (num >= 1 && num <= totalSlides) return num;
    }
    return 1;
  }

  let currentSlide = getSlideFromHash();

  function updateSlide() {
    // Salva o slide atual na URL
    window.history.replaceState(null, '', `#slide-${currentSlide}`);
    slides.forEach((slide, index) => {
      if (index + 1 === currentSlide) {
        slide.classList.add('active');
      } else {
        slide.classList.remove('active');
      }
    });

    if (slideInput) {
      slideInput.value = String(currentSlide);
    }
    if (totalSlidesSpan) {
      totalSlidesSpan.textContent = String(totalSlides);
    }

    if (progressBar) {
      progressBar.style.width = `${(currentSlide / totalSlides) * 100}%`;
    }

    if (prevBtn) {
      prevBtn.disabled = currentSlide === 1;
    }

    if (nextBtn) {
      nextBtn.disabled = currentSlide === totalSlides;
    }
  }

  prevBtn?.addEventListener('click', () => {
    if (currentSlide > 1) {
      currentSlide--;
      updateSlide();
    }
  });

  nextBtn?.addEventListener('click', () => {
    if (currentSlide < totalSlides) {
      currentSlide++;
      updateSlide();
    }
  });

  // Input para ir direto ao slide
  slideInput?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      e.preventDefault();
      const num = parseInt(slideInput.value, 10);
      if (!isNaN(num) && num >= 1 && num <= totalSlides) {
        currentSlide = num;
        updateSlide();
      } else {
        slideInput.value = String(currentSlide);
      }
      slideInput.blur();
    } else if (e.key === 'Escape') {
      slideInput.value = String(currentSlide);
      slideInput.blur();
    }
  });

  slideInput?.addEventListener('focus', () => {
    slideInput.select();
  });

  // Keyboard navigation
  document.addEventListener('keydown', (e) => {
    // Ignora atalhos quando estiver editando o input
    if (document.activeElement === slideInput) return;

    if (e.key === 'ArrowRight' || e.key === ' ' || e.key === 'PageDown') {
      e.preventDefault();
      if (currentSlide < totalSlides) {
        currentSlide++;
        updateSlide();
      }
    } else if (e.key === 'ArrowLeft' || e.key === 'PageUp') {
      e.preventDefault();
      if (currentSlide > 1) {
        currentSlide--;
        updateSlide();
      }
    } else if (e.key === 'Home') {
      e.preventDefault();
      currentSlide = 1;
      updateSlide();
    } else if (e.key === 'End') {
      e.preventDefault();
      currentSlide = totalSlides;
      updateSlide();
    } else if (e.key === 'f' || e.key === 'F') {
      toggleFullscreen();
    }
  });

  // Fullscreen
  function toggleFullscreen() {
    if (!document.fullscreenElement) {
      presentation?.requestFullscreen();
    } else {
      document.exitFullscreen();
    }
  }

  fullscreenBtn?.addEventListener('click', toggleFullscreen);

  // Zoom and Pan functionality
  const slidesContainer = document.getElementById('slides-container');
  let zoomLevel = 1;
  let panX = 0;
  let panY = 0;
  let isDragging = false;
  let startX = 0;
  let startY = 0;
  const zoomStep = 0.1;
  const minZoom = 0.5;
  const maxZoom = 3;

  function updateTransform() {
    if (slidesContainer) {
      slidesContainer.style.transform = `translate(${panX}px, ${panY}px) scale(${zoomLevel})`;
      slidesContainer.style.transformOrigin = 'center center';
      // Muda o cursor quando tem zoom
      slidesContainer.style.cursor = zoomLevel > 1 ? 'grab' : 'default';
    }
  }

  function zoomIn() {
    if (zoomLevel < maxZoom) {
      zoomLevel = Math.min(maxZoom, zoomLevel + zoomStep);
      updateTransform();
    }
  }

  function zoomOut() {
    if (zoomLevel > minZoom) {
      zoomLevel = Math.max(minZoom, zoomLevel - zoomStep);
      // Se voltar ao zoom 1, reseta a posição
      if (zoomLevel <= 1) {
        panX = 0;
        panY = 0;
      }
      updateTransform();
    }
  }

  function resetZoom() {
    zoomLevel = 1;
    panX = 0;
    panY = 0;
    updateTransform();
  }

  // Ctrl + scroll para zoom
  document.addEventListener('wheel', (e) => {
    if (e.ctrlKey) {
      e.preventDefault();
      if (e.deltaY < 0) {
        zoomIn();
      } else {
        zoomOut();
      }
    }
  }, { passive: false });

  // Drag para mover quando tem zoom
  slidesContainer?.addEventListener('mousedown', (e) => {
    if (zoomLevel > 1) {
      isDragging = true;
      startX = e.clientX - panX;
      startY = e.clientY - panY;
      slidesContainer.style.cursor = 'grabbing';
    }
  });

  document.addEventListener('mousemove', (e) => {
    if (isDragging && zoomLevel > 1) {
      panX = e.clientX - startX;
      panY = e.clientY - startY;
      updateTransform();
    }
  });

  document.addEventListener('mouseup', () => {
    if (isDragging) {
      isDragging = false;
      if (slidesContainer) {
        slidesContainer.style.cursor = zoomLevel > 1 ? 'grab' : 'default';
      }
    }
  });

  // Teclas + e - para zoom, 0 para resetar
  document.addEventListener('keydown', (e) => {
    if (document.activeElement === slideInput) return;
    if (e.key === '+' || e.key === '=') {
      e.preventDefault();
      zoomIn();
    } else if (e.key === '-') {
      e.preventDefault();
      zoomOut();
    } else if (e.key === '0') {
      e.preventDefault();
      resetZoom();
    }
  });

  // Theme Toggle
  const themeBtn = document.getElementById('theme-btn');
  const themeIconDark = document.getElementById('theme-icon-dark');
  const themeIconLight = document.getElementById('theme-icon-light');
  const mainElement = document.getElementById('main-presentation');

  function setTheme(isLight: boolean) {
    if (isLight) {
      mainElement?.classList.remove('presentation-dark');
      mainElement?.classList.add('presentation-light');
      themeIconDark?.classList.add('hidden');
      themeIconLight?.classList.remove('hidden');
      localStorage.setItem('presentation-theme', 'light');
    } else {
      mainElement?.classList.remove('presentation-light');
      mainElement?.classList.add('presentation-dark');
      themeIconDark?.classList.remove('hidden');
      themeIconLight?.classList.add('hidden');
      localStorage.setItem('presentation-theme', 'dark');
    }
  }

  // Load saved theme
  const savedTheme = localStorage.getItem('presentation-theme');
  if (savedTheme === 'light') {
    setTheme(true);
  }

  themeBtn?.addEventListener('click', () => {
    const isCurrentlyLight = mainElement?.classList.contains('presentation-light');
    setTheme(!isCurrentlyLight);
  });

  // Keyboard shortcut for theme (T key)
  document.addEventListener('keydown', (e) => {
    if (document.activeElement === slideInput) return;
    if (e.key === 't' || e.key === 'T') {
      const isCurrentlyLight = mainElement?.classList.contains('presentation-light');
      setTheme(!isCurrentlyLight);
    }
  });

  // ===== NORMAL VALUES POPUP (DRAGGABLE) =====
  const normalValuesBtn = document.getElementById('toggle-normal-values');
  const normalValuesPopup = document.getElementById('normal-values-popup');
  const normalValuesCard = normalValuesPopup?.querySelector('.normal-values-card') as HTMLElement;
  const closeNormalValuesBtn = document.getElementById('close-normal-values');

  function showNormalValues() {
    normalValuesPopup?.classList.add('show');
  }

  function hideNormalValues() {
    normalValuesPopup?.classList.remove('show');
  }

  normalValuesBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    const isVisible = normalValuesPopup?.classList.contains('show');
    if (isVisible) {
      hideNormalValues();
    } else {
      showNormalValues();
    }
  });

  closeNormalValuesBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    hideNormalValues();
  });

  // Fechar com Escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      if (normalValuesPopup?.classList.contains('show')) {
        hideNormalValues();
      }
      if (ventricularPopup?.classList.contains('show')) {
        hideVentricular();
      }
    }
  });

  // ===== VENTRICULAR POPUP (COM BACKDROP) =====
  const ventricularBtn = document.getElementById('toggle-ventricular-table');
  const ventricularPopup = document.getElementById('ventricular-popup');
  const ventricularBackdrop = document.getElementById('ventricular-backdrop');
  const closeVentricularBtn = document.getElementById('close-ventricular');

  function showVentricular() {
    ventricularPopup?.classList.add('show');
  }

  function hideVentricular() {
    ventricularPopup?.classList.remove('show');
  }

  ventricularBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    showVentricular();
  });

  closeVentricularBtn?.addEventListener('click', hideVentricular);
  ventricularBackdrop?.addEventListener('click', hideVentricular);

  // ===== DRAG FUNCTIONALITY PARA TODOS OS POPUPS =====
  let currentDragPopup: HTMLElement | null = null;
  let currentDragCard: HTMLElement | null = null;
  let dragStartX = 0;
  let dragStartY = 0;
  let dragOffsetX = 0;
  let dragOffsetY = 0;

  // Função genérica para iniciar o arraste
  function startDrag(e: MouseEvent, popup: HTMLElement, card: HTMLElement, closeSelector: string) {
    if ((e.target as HTMLElement).closest(closeSelector)) return;

    currentDragPopup = popup;
    currentDragCard = card;
    dragStartX = e.clientX;
    dragStartY = e.clientY;

    const rect = popup.getBoundingClientRect();
    dragOffsetX = rect.left;
    dragOffsetY = rect.top;

    card.classList.add('dragging');
    e.preventDefault();
  }

  // Normal Values
  normalValuesCard?.addEventListener('mousedown', (e) => {
    startDrag(e, normalValuesPopup!, normalValuesCard!, '#close-normal-values');
  });

  // Ventricular
  const ventricularCard = ventricularPopup?.querySelector('.ventricular-card') as HTMLElement;
  ventricularCard?.addEventListener('mousedown', (e) => {
    startDrag(e, ventricularPopup!, ventricularCard!, '#close-ventricular');
  });

  // Shock Table
  const shockTableCard = document.querySelector('.shock-table-popup-card') as HTMLElement;
  const shockTablePopupEl = document.getElementById('shock-table-popup');
  shockTableCard?.addEventListener('mousedown', (e) => {
    startDrag(e, shockTablePopupEl!, shockTableCard!, '#close-shock-table');
  });

  document.addEventListener('mousemove', (e) => {
    if (!currentDragPopup) return;

    const deltaX = e.clientX - dragStartX;
    const deltaY = e.clientY - dragStartY;

    currentDragPopup.style.left = `${dragOffsetX + deltaX}px`;
    currentDragPopup.style.top = `${dragOffsetY + deltaY}px`;
    currentDragPopup.style.right = 'auto';
    currentDragPopup.style.transform = 'none';
  });

  document.addEventListener('mouseup', () => {
    if (currentDragCard) {
      currentDragCard.classList.remove('dragging');
    }
    currentDragPopup = null;
    currentDragCard = null;
  });

  // ===== SHOCK TABLE POPUP =====
  const shockTablePopup = document.getElementById('shock-table-popup');
  const shockTableBackdrop = document.getElementById('shock-table-backdrop');
  const closeShockTableBtn = document.getElementById('close-shock-table');

  function showShockTable() {
    shockTablePopup?.classList.add('show');
  }

  function hideShockTable() {
    shockTablePopup?.classList.remove('show');
  }

  closeShockTableBtn?.addEventListener('click', hideShockTable);
  shockTableBackdrop?.addEventListener('click', hideShockTable);

  // ===== PAPI POPUP =====
  const papiPopup = document.getElementById('papi-popup');
  const closePapiBtn = document.getElementById('close-papi');
  const papiCard = papiPopup?.querySelector('.papi-card') as HTMLElement;

  function showPapi() {
    papiPopup?.classList.add('show');
  }

  function hidePapi() {
    papiPopup?.classList.remove('show');
  }

  closePapiBtn?.addEventListener('click', hidePapi);

  // Drag para PAPi
  papiCard?.addEventListener('mousedown', (e) => {
    startDrag(e, papiPopup!, papiCard!, '#close-papi');
  });

  // ===== FIGURA 4 POPUP (Slide 20) =====
  const figura4Popup = document.getElementById('figura4-popup');
  const closeFigura4Btn = document.getElementById('close-figura4');
  const figura4Card = figura4Popup?.querySelector('.figura4-card') as HTMLElement;
  const figura4Img = document.getElementById('figura4-img') as HTMLImageElement;
  const figura4Container = document.getElementById('figura4-img-container') as HTMLElement;
  const figura4ZoomIn = document.getElementById('figura4-zoom-in');
  const figura4ZoomOut = document.getElementById('figura4-zoom-out');
  const figura4ZoomReset = document.getElementById('figura4-zoom-reset');
  const figura4ZoomLevel = document.getElementById('figura4-zoom-level');

  let figura4Zoom = 1;
  const ZOOM_STEP = 0.25;
  const MIN_ZOOM = 0.5;
  const MAX_ZOOM = 4;

  function updateFigura4Zoom() {
    if (figura4Img) {
      figura4Img.style.transform = `scale(${figura4Zoom})`;
    }
    if (figura4ZoomLevel) {
      figura4ZoomLevel.textContent = `${Math.round(figura4Zoom * 100)}%`;
    }
  }

  function showFigura4() {
    figura4Popup?.classList.add('show');
    figura4Zoom = 1;
    updateFigura4Zoom();
    if (figura4Container) {
      figura4Container.scrollLeft = 0;
      figura4Container.scrollTop = 0;
    }
  }

  function hideFigura4() {
    figura4Popup?.classList.remove('show');
  }

  figura4ZoomIn?.addEventListener('click', (e) => {
    e.stopPropagation();
    if (figura4Zoom < MAX_ZOOM) {
      figura4Zoom = Math.min(figura4Zoom + ZOOM_STEP, MAX_ZOOM);
      updateFigura4Zoom();
    }
  });

  figura4ZoomOut?.addEventListener('click', (e) => {
    e.stopPropagation();
    if (figura4Zoom > MIN_ZOOM) {
      figura4Zoom = Math.max(figura4Zoom - ZOOM_STEP, MIN_ZOOM);
      updateFigura4Zoom();
    }
  });

  figura4ZoomReset?.addEventListener('click', (e) => {
    e.stopPropagation();
    figura4Zoom = 1;
    updateFigura4Zoom();
    if (figura4Container) {
      figura4Container.scrollLeft = 0;
      figura4Container.scrollTop = 0;
    }
  });

  // Zoom com scroll do mouse
  figura4Container?.addEventListener('wheel', (e) => {
    e.preventDefault();
    if (e.deltaY < 0 && figura4Zoom < MAX_ZOOM) {
      figura4Zoom = Math.min(figura4Zoom + ZOOM_STEP, MAX_ZOOM);
    } else if (e.deltaY > 0 && figura4Zoom > MIN_ZOOM) {
      figura4Zoom = Math.max(figura4Zoom - ZOOM_STEP, MIN_ZOOM);
    }
    updateFigura4Zoom();
  });

  // Drag para mover imagem dentro do container
  let isDraggingImg = false;
  let imgStartX = 0;
  let imgStartY = 0;
  let imgScrollLeft = 0;
  let imgScrollTop = 0;

  figura4Container?.addEventListener('mousedown', (e) => {
    isDraggingImg = true;
    imgStartX = e.pageX - figura4Container.offsetLeft;
    imgStartY = e.pageY - figura4Container.offsetTop;
    imgScrollLeft = figura4Container.scrollLeft;
    imgScrollTop = figura4Container.scrollTop;
  });

  figura4Container?.addEventListener('mouseleave', () => {
    isDraggingImg = false;
  });

  figura4Container?.addEventListener('mouseup', () => {
    isDraggingImg = false;
  });

  figura4Container?.addEventListener('mousemove', (e) => {
    if (!isDraggingImg) return;
    e.preventDefault();
    const x = e.pageX - figura4Container.offsetLeft;
    const y = e.pageY - figura4Container.offsetTop;
    const walkX = (x - imgStartX) * 1.5;
    const walkY = (y - imgStartY) * 1.5;
    figura4Container.scrollLeft = imgScrollLeft - walkX;
    figura4Container.scrollTop = imgScrollTop - walkY;
  });

  closeFigura4Btn?.addEventListener('click', hideFigura4);

  // Botão para abrir figura 4 (Slide 20)
  document.querySelectorAll('.figura4-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      showFigura4();
    });
  });

  // ===== SCAI POPUP (Slide 11) =====
