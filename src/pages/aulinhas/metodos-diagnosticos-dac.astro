    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .slide-popup.hidden { display: none; }
  .slide-popup-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(8px);
  }
  .slide-popup-content {
    position: relative;
    z-index: 101;
    max-width: 90vw;
    max-height: 90vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
  }
  .slide-popup-content--wide {
    background: rgba(23, 23, 23, 0.95);
    border: 1px solid rgba(168, 85, 247, 0.3);
    border-radius: 1rem;
    max-width: 800px;
    width: 90vw;
  }
  .slide-popup-close {
    position: absolute;
    top: 0.5rem;
    right: 0.75rem;
    background: none;
    border: none;
    color: #a1a1aa;
    font-size: 2rem;
    cursor: pointer;
    line-height: 1;
    z-index: 102;
    transition: color 0.2s;
  }
  .slide-popup-close:hover { color: #fff; }

  /* Fullscreen auto-hide */
  .fs-hidden {
    opacity: 0 !important;
    pointer-events: none !important;
    transition: opacity 0.4s ease !important;
  }
  .fs-visible {
    opacity: 1 !important;
    pointer-events: auto !important;
    transition: opacity 0.3s ease !important;
  }

  /* Light mode - popups */
  .presentation-light .slide-popup-backdrop {
    background: rgba(255, 255, 255, 0.9) !important;
  }
  .presentation-light .slide-popup-content--wide {
    background: rgba(250, 250, 250, 0.98) !important;
    border-color: rgba(147, 51, 234, 0.25) !important;
  }
  .presentation-light .slide-popup-close { color: #737373 !important; }
  .presentation-light .slide-popup-close:hover { color: #171717 !important; }
  .presentation-light .slide-popup-content--wide .bg-neutral-800\/80,
  .presentation-light .slide-popup-content--wide .bg-neutral-800\/50 {
    background-color: #f0f0f0 !important;
  }
  .presentation-light .slide-popup-content--wide .text-neutral-200,
  .presentation-light .slide-popup-content--wide .text-neutral-300 {
    color: #262626 !important;
  }
  .presentation-light .slide-popup-content--wide .text-neutral-400 {
    color: #404040 !important;
  }

  /* Light mode - slide 1 */
  .presentation-light [data-slide="1"] {
    background: linear-gradient(135deg, #f8fafc, #eff6ff, #ecfeff) !important;
  }
  .presentation-light [data-slide="1"] .bg-blue-500\/5,
  .presentation-light [data-slide="1"] .bg-cyan-500\/5 { opacity: 0.3 !important; }
  .presentation-light .ring-offset-neutral-900 { --tw-ring-offset-color: #fafafa !important; }
  .presentation-light .border-neutral-800\/60 { border-color: #d4d4d4 !important; }
  .presentation-light .bg-neutral-800\/80 { background-color: #e5e5e5 !important; }
  .presentation-light .border-neutral-700\/50 { border-color: #d4d4d4 !important; }
  .presentation-light .border-blue-500\/25 { border-color: rgba(37, 99, 235, 0.3) !important; }
  .presentation-light .border-blue-500\/40 { border-color: rgba(37, 99, 235, 0.35) !important; }
  .presentation-light .border-purple-500\/40 { border-color: rgba(147, 51, 234, 0.35) !important; }
  .presentation-light [data-slide="1"] .bg-clip-text.text-transparent {
    background: linear-gradient(135deg, #1e3a5f, #1d4ed8, #0e7490) !important;
    -webkit-background-clip: text !important;
    background-clip: text !important;
  }
  .presentation-light .bg-neutral-900\/95 { background-color: #f5f5f5 !important; }

  /* ===== MOBILE RESPONSIVE ===== */
  @media (max-width: 768px) {
    .fixed.bottom-6 {
      bottom: 1rem !important;
      padding: 0.5rem 1rem !important;
    }

    .slide {
      padding-left: 1rem !important;
      padding-right: 1rem !important;
    }

    .slide h1 { font-size: 2rem !important; }
    .slide h2 { font-size: 1.5rem !important; margin-bottom: 1rem !important; }
    .slide h3 { font-size: 1rem !important; }

    .grid.md\:grid-cols-2,
    .grid.md\:grid-cols-3,
    .grid.md\:grid-cols-4 {
      grid-template-columns: 1fr !important;
    }

    .rounded-2xl { border-radius: 12px !important; }
    .p-6 { padding: 1rem !important; }
    .p-8 { padding: 1.25rem !important; }
    .text-3xl { font-size: 1.5rem !important; }
    .text-4xl { font-size: 1.75rem !important; }
  }

  @media (max-width: 480px) {
    .slide h1 { font-size: 1.5rem !important; }
    .slide h2 { font-size: 1.25rem !important; }
  }
</style>

<script>
  const slides = document.querySelectorAll('.slide');
  const prevBtn = document.getElementById('prev-btn') as HTMLButtonElement;
  const nextBtn = document.getElementById('next-btn') as HTMLButtonElement;
  const slideInput = document.getElementById('slide-input') as HTMLInputElement;
  const totalSlidesSpan = document.getElementById('total-slides');
  const progressBar = document.getElementById('progress-bar');
  const fullscreenBtn = document.getElementById('fullscreen-btn');
  const presentation = document.getElementById('presentation');

  const totalSlides = slides.length;

  function getSlideFromHash() {
    const hash = window.location.hash;
    const match = hash.match(/^#slide-(\d+)$/);
    if (match) {
      const num = parseInt(match[1], 10);
      if (num >= 1 && num <= totalSlides) return num;
    }
    return 1;
  }

  let currentSlide = getSlideFromHash();

  function updateSlide() {
    window.history.replaceState(null, '', `#slide-${currentSlide}`);
    slides.forEach((slide, index) => {
      if (index + 1 === currentSlide) {
        slide.classList.add('active');
      } else {
        slide.classList.remove('active');
      }
    });

    if (slideInput) slideInput.value = String(currentSlide);
    if (totalSlidesSpan) totalSlidesSpan.textContent = String(totalSlides);
    if (progressBar) progressBar.style.width = `${(currentSlide / totalSlides) * 100}%`;
    if (prevBtn) prevBtn.disabled = currentSlide === 1;
    if (nextBtn) nextBtn.disabled = currentSlide === totalSlides;
  }

  prevBtn?.addEventListener('click', () => {
    if (currentSlide > 1) { currentSlide--; updateSlide(); }
  });

  nextBtn?.addEventListener('click', () => {
    if (currentSlide < totalSlides) { currentSlide++; updateSlide(); }
  });

  slideInput?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      e.preventDefault();
      const num = parseInt(slideInput.value, 10);
      if (!isNaN(num) && num >= 1 && num <= totalSlides) {
        currentSlide = num;
        updateSlide();
      } else {
        slideInput.value = String(currentSlide);
      }
      slideInput.blur();
    } else if (e.key === 'Escape') {
      slideInput.value = String(currentSlide);
      slideInput.blur();
    }
  });

  slideInput?.addEventListener('focus', () => { slideInput.select(); });

  // Keyboard navigation
  document.addEventListener('keydown', (e) => {
    if (document.activeElement === slideInput) return;

    if (e.key === 'ArrowRight' || e.key === ' ' || e.key === 'PageDown') {
      e.preventDefault();
      if (currentSlide < totalSlides) { currentSlide++; updateSlide(); }
    } else if (e.key === 'ArrowLeft' || e.key === 'PageUp') {
      e.preventDefault();
      if (currentSlide > 1) { currentSlide--; updateSlide(); }
    } else if (e.key === 'Home') {
      e.preventDefault(); currentSlide = 1; updateSlide();
    } else if (e.key === 'End') {
      e.preventDefault(); currentSlide = totalSlides; updateSlide();
    } else if (e.key === 'f' || e.key === 'F') {
      toggleFullscreen();
    }
  });

  // Fullscreen
  function toggleFullscreen() {
    if (!document.fullscreenElement) {
      presentation?.requestFullscreen();
    } else {
      document.exitFullscreen();
    }
  }

  fullscreenBtn?.addEventListener('click', toggleFullscreen);

  // Zoom and Pan
  const slidesContainer = document.getElementById('slides-container');
  let zoomLevel = 1;
  let panX = 0;
  let panY = 0;
  let isDragging = false;
  let startX = 0;
  let startY = 0;

  function updateTransform() {
    if (slidesContainer) {
      slidesContainer.style.transform = `translate(${panX}px, ${panY}px) scale(${zoomLevel})`;
      slidesContainer.style.transformOrigin = 'center center';
      slidesContainer.style.cursor = zoomLevel > 1 ? 'grab' : 'default';
    }
  }

  function zoomIn() { if (zoomLevel < 3) { zoomLevel = Math.min(3, zoomLevel + 0.1); updateTransform(); } }
  function zoomOut() { if (zoomLevel > 0.5) { zoomLevel = Math.max(0.5, zoomLevel - 0.1); if (zoomLevel <= 1) { panX = 0; panY = 0; } updateTransform(); } }
  function resetZoom() { zoomLevel = 1; panX = 0; panY = 0; updateTransform(); }

  document.addEventListener('wheel', (e) => {
    if (e.ctrlKey) { e.preventDefault(); e.deltaY < 0 ? zoomIn() : zoomOut(); }
  }, { passive: false });

  slidesContainer?.addEventListener('mousedown', (e) => {
    if (zoomLevel > 1) { isDragging = true; startX = e.clientX - panX; startY = e.clientY - panY; slidesContainer.style.cursor = 'grabbing'; }
  });

  document.addEventListener('mousemove', (e) => {
    if (isDragging && zoomLevel > 1) { panX = e.clientX - startX; panY = e.clientY - startY; updateTransform(); }
  });

  document.addEventListener('mouseup', () => {
    if (isDragging) { isDragging = false; if (slidesContainer) slidesContainer.style.cursor = zoomLevel > 1 ? 'grab' : 'default'; }
  });

  document.addEventListener('keydown', (e) => {
    if (document.activeElement === slideInput) return;
    if (e.key === '+' || e.key === '=') { e.preventDefault(); zoomIn(); }
    else if (e.key === '-') { e.preventDefault(); zoomOut(); }
    else if (e.key === '0') { e.preventDefault(); resetZoom(); }
  });

  // Theme Toggle
  const themeBtn = document.getElementById('theme-btn');
  const themeIconDark = document.getElementById('theme-icon-dark');
  const themeIconLight = document.getElementById('theme-icon-light');
  const mainElement = document.getElementById('main-presentation');

  function setTheme(isLight: boolean) {
    if (isLight) {
      mainElement?.classList.remove('presentation-dark');
      mainElement?.classList.add('presentation-light');
      themeIconDark?.classList.add('hidden');
      themeIconLight?.classList.remove('hidden');
      localStorage.setItem('presentation-theme', 'light');
    } else {
      mainElement?.classList.remove('presentation-light');
      mainElement?.classList.add('presentation-dark');
      themeIconDark?.classList.remove('hidden');
      themeIconLight?.classList.add('hidden');
      localStorage.setItem('presentation-theme', 'dark');
    }
  }

  const savedTheme = localStorage.getItem('presentation-theme');
  if (savedTheme === 'light') setTheme(true);

  themeBtn?.addEventListener('click', () => {
    const isCurrentlyLight = mainElement?.classList.contains('presentation-light');
    setTheme(!isCurrentlyLight);
  });

  document.addEventListener('keydown', (e) => {
    if (document.activeElement === slideInput) return;
    if (e.key === 't' || e.key === 'T') {
      const isCurrentlyLight = mainElement?.classList.contains('presentation-light');
      setTheme(!isCurrentlyLight);
    }
  });

  // Touch support for mobile
  let touchStartX = 0;
  let touchStartY = 0;

  document.addEventListener('touchstart', (e) => {
    touchStartX = e.touches[0].clientX;
    touchStartY = e.touches[0].clientY;
  });

  document.addEventListener('touchend', (e) => {
    const touchEndX = e.changedTouches[0].clientX;
    const touchEndY = e.changedTouches[0].clientY;
    const deltaX = touchEndX - touchStartX;
    const deltaY = touchEndY - touchStartY;

    if (Math.abs(deltaX) > Math.abs(deltaY) && Math.abs(deltaX) > 50) {
      if (deltaX < 0 && currentSlide < totalSlides) { currentSlide++; updateSlide(); }
      else if (deltaX > 0 && currentSlide > 1) { currentSlide--; updateSlide(); }
    }
  });

  // Popup buttons - open
  document.querySelectorAll('[id^="btn-"]').forEach(btn => {
    btn.addEventListener('click', () => {
      const targetId = btn.id.replace('btn-', '');
      const popup = document.getElementById(targetId);
      popup?.classList.remove('hidden');
    });
  });

  // Close popups on backdrop click or close button
  document.querySelectorAll('.slide-popup-backdrop, .slide-popup-close').forEach(el => {
    el.addEventListener('click', () => {
      el.closest('.slide-popup')?.classList.add('hidden');
    });
  });

  // Close popup on Escape key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      document.querySelectorAll('.slide-popup:not(.hidden)').forEach(p => p.classList.add('hidden'));
    }
  });

  // Fullscreen auto-hide UI
  const fsUiElements = document.querySelectorAll('.fs-ui');
  let fsHideTimeout: ReturnType<typeof setTimeout> | null = null;
  let isFullscreen = false;

  function hideUI() {
    if (!isFullscreen) return;
    fsUiElements.forEach(el => { el.classList.add('fs-hidden'); el.classList.remove('fs-visible'); });
  }

  function showUI() {
    fsUiElements.forEach(el => { el.classList.remove('fs-hidden'); el.classList.add('fs-visible'); });
    if (isFullscreen) {
      if (fsHideTimeout) clearTimeout(fsHideTimeout);
      fsHideTimeout = setTimeout(hideUI, 2500);
    }
  }

  document.addEventListener('fullscreenchange', () => {
    isFullscreen = !!document.fullscreenElement;
    if (isFullscreen) {
      fsHideTimeout = setTimeout(hideUI, 2500);
    } else {
      if (fsHideTimeout) clearTimeout(fsHideTimeout);
      fsUiElements.forEach(el => { el.classList.remove('fs-hidden', 'fs-visible'); });
    }
  });

  document.addEventListener('mousemove', () => {
    if (isFullscreen) showUI();
  });

  // Initialize
  updateSlide();
</script>
