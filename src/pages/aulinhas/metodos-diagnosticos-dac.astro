---
import "../../styles/base.css";
import Layout from "../../layouts/Layout.astro";
---

<Layout
  title="Métodos Diagnósticos para DAC - Apresentação Médica"
  description="Apresentação sobre métodos diagnósticos para doença arterial coronariana baseada nas diretrizes SBC 2025 e ESC 2024"
  noindex={true}
>
  <main id="main-presentation" class="presentation-dark min-h-screen overflow-hidden">
    <!-- Slide Container -->
    <div id="presentation" class="relative w-full h-screen">

      <!-- Progress Bar -->
      <div class="fs-ui fixed top-0 left-0 w-full h-1 bg-neutral-800 z-50">
        <div id="progress-bar" class="h-full bg-gradient-to-r from-blue-500 to-cyan-500 transition-all duration-300" style="width: 0%"></div>
      </div>

      <!-- Back to Aulinhas -->
      <a href="/aulinhas" class="fs-ui fixed top-3 md:top-6 left-3 md:left-6 z-50 p-2 md:p-3 bg-neutral-900/90 backdrop-blur-sm hover:bg-neutral-700 rounded-full border border-neutral-700 transition-colors text-cyan-300 hover:text-cyan-200">
        <svg class="w-4 h-4 md:w-5 md:h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
      </a>

      <!-- Navigation -->
      <div class="fs-ui fixed bottom-4 md:bottom-6 left-1/2 -translate-x-1/2 z-50 flex items-center gap-2 md:gap-4 bg-neutral-900/90 backdrop-blur-sm px-4 md:px-6 py-2 md:py-3 rounded-full border border-neutral-700">
        <button id="prev-btn" class="p-1.5 md:p-2 hover:bg-neutral-700 rounded-full transition-colors disabled:opacity-30" disabled>
          <svg class="w-5 h-5 md:w-6 md:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
          </svg>
        </button>
        <div class="flex items-center gap-1 text-xs md:text-sm font-medium">
          <input id="slide-input" type="text" value="1" class="w-6 md:w-8 bg-transparent text-center border-b border-transparent hover:border-neutral-500 focus:border-blue-400 focus:outline-none transition-colors" />
          <span>/ <span id="total-slides">38</span></span>
        </div>
        <button id="next-btn" class="p-1.5 md:p-2 hover:bg-neutral-700 rounded-full transition-colors">
          <svg class="w-5 h-5 md:w-6 md:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </button>
      </div>

      <!-- Theme Toggle Button -->
      <button id="theme-btn" class="fs-ui fixed top-3 md:top-6 right-14 md:right-20 z-50 p-2 md:p-3 bg-neutral-900/90 backdrop-blur-sm hover:bg-neutral-700 rounded-full border border-neutral-700 transition-colors" title="Alternar tema">
        <svg id="theme-icon-dark" class="w-4 h-4 md:w-5 md:h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/>
        </svg>
        <svg id="theme-icon-light" class="w-4 h-4 md:w-5 md:h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/>
        </svg>
      </button>

      <!-- Fullscreen Button -->
      <button id="fullscreen-btn" class="fs-ui fixed top-3 md:top-6 right-3 md:right-6 z-50 p-2 md:p-3 bg-neutral-900/90 backdrop-blur-sm hover:bg-neutral-700 rounded-full border border-neutral-700 transition-colors">
        <svg class="w-4 h-4 md:w-5 md:h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"/>
        </svg>
      </button>

      <!-- SLIDES -->
      <div id="slides-container" class="w-full h-full">

        <!-- Slide 1: Titulo -->
        <section class="slide active flex flex-col items-center justify-center h-full px-8 text-center" data-slide="1">
          <div class="max-w-5xl mx-auto">
            <div class="inline-flex items-center gap-2 px-4 py-2 bg-blue-500/20 border border-blue-500/30 rounded-full text-blue-400 text-sm font-medium mb-8">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" clip-rule="evenodd"/>
              </svg>
              Medicina Nuclear
            </div>
            <h1 class="text-4xl md:text-7xl pb-2 font-bold mb-6 bg-gradient-to-r from-white via-blue-100 to-cyan-200 bg-clip-text text-transparent">
              Métodos Diagnósticos para Doença Arterial Coronariana
            </h1>
            <p class="text-xl md:text-2xl text-neutral-300 mb-8">
              Abordagem Baseada em Evidências
            </p>
            <div class="flex flex-wrap justify-center gap-4 text-sm text-neutral-400">
              <span class="px-3 py-1 bg-neutral-800 rounded-full">Diretriz SBC 2025</span>
              <span class="px-3 py-1 bg-neutral-800 rounded-full">ESC Guidelines 2024</span>
            </div>
            <div class="mt-12 pt-8 border-t border-neutral-800">
              <p class="text-neutral-500 text-sm">Apresentado por Laura Ricarte <br/> Residente de Cardiologia — Instituto Dante Pazzanese de Cardiologia</p>
            </div>
          </div>
        </section>

        <!-- Slide 2: Objetivos -->
        <section class="slide flex flex-col items-center justify-center h-full px-4 md:px-8 py-6 md:py-8 overflow-y-auto" data-slide="2">
          <div class="max-w-4xl mx-auto w-full">
            <h2 class="text-4xl font-bold mb-12 text-center">Objetivos de Aprendizagem</h2>
            <div class="grid md:grid-cols-2 gap-6">
              <div class="bg-neutral-900/50 border border-neutral-700 rounded-2xl p-6 hover:border-blue-500/50 transition-colors">
                <div class="w-12 h-12 bg-blue-500/20 rounded-xl flex items-center justify-center mb-4">
                  <span class="text-2xl font-bold text-blue-400">1</span>
                </div>
                <h3 class="text-lg font-semibold mb-2">Estimar Probabilidade</h3>
                <p class="text-neutral-400 text-sm">Aplicar modelos de probabilidade clínica pré-teste para DAC obstrutiva (RF-CL)</p>
              </div>
              <div class="bg-neutral-900/50 border border-neutral-700 rounded-2xl p-6 hover:border-blue-500/50 transition-colors">
                <div class="w-12 h-12 bg-blue-500/20 rounded-xl flex items-center justify-center mb-4">
                  <span class="text-2xl font-bold text-blue-400">2</span>
                </div>
                <h3 class="text-lg font-semibold mb-2">Escolher o Exame</h3>
                <p class="text-neutral-400 text-sm">Selecionar o método diagnóstico adequado conforme a probabilidade clínica</p>
              </div>
              <div class="bg-neutral-900/50 border border-neutral-700 rounded-2xl p-6 hover:border-blue-500/50 transition-colors">
                <div class="w-12 h-12 bg-blue-500/20 rounded-xl flex items-center justify-center mb-4">
                  <span class="text-2xl font-bold text-blue-400">3</span>
                </div>
                <h3 class="text-lg font-semibold mb-2">Interpretar Resultados</h3>
                <p class="text-neutral-400 text-sm">Reconhecer critérios de alto risco em cada modalidade diagnóstica</p>
              </div>
              <div class="bg-neutral-900/50 border border-neutral-700 rounded-2xl p-6 hover:border-blue-500/50 transition-colors">
                <div class="w-12 h-12 bg-blue-500/20 rounded-xl flex items-center justify-center mb-4">
                  <span class="text-2xl font-bold text-blue-400">4</span>
                </div>
                <h3 class="text-lg font-semibold mb-2">Integrar Evidências</h3>
                <p class="text-neutral-400 text-sm">Comparar recomendações SBC 2025 e ESC 2024 na prática clínica</p>
              </div>
            </div>
          </div>
        </section>

        <!-- Slide 3: O que é Síndrome Coronariana Crônica? -->
        <section class="slide flex flex-col items-center justify-start md:justify-center h-full px-4 md:px-8 py-6 md:py-8 overflow-y-auto" data-slide="3">
          <div class="max-w-5xl mx-auto w-full">
            <h2 class="text-3xl md:text-4xl font-bold mb-6 text-center">O que é Síndrome Coronariana Crônica?</h2>
            <div class="bg-gradient-to-br from-blue-500/10 to-cyan-600/5 border border-blue-500/20 rounded-3xl p-6 md:p-8 mb-5">
              <p class="text-lg md:text-xl text-center leading-relaxed">
                Apresentações clínicas que surgem por <span class="text-blue-400 font-semibold">alterações estruturais e/ou funcionais</span> das artérias coronárias e/ou da <span class="text-blue-400 font-semibold">microcirculação</span>, levando a <span class="text-cyan-400 font-semibold">mismatch transitório e reversível</span> entre demanda e oferta miocárdica de oxigênio, resultando em <span class="text-blue-400 font-semibold">hipoperfusão (isquemia)</span>.
              </p>
              <p class="text-center text-neutral-400 text-sm mt-3">
                Geralmente provocada por esforço, emoção ou outro estresse — pode se manifestar como <span class="text-neutral-300">angina, desconforto torácico, dispneia</span> ou ser <span class="text-neutral-300">assintomática</span>.
              </p>
              <p class="text-center text-neutral-500 text-xs mt-3">— ESC Guidelines 2024</p>
            </div>
            <div class="bg-amber-500/10 border border-amber-500/30 rounded-xl p-4 mb-5">
              <p class="text-amber-200 text-sm text-center">
                <span class="font-semibold">Doença</span> = patologia coronariana subjacente &nbsp;|&nbsp; <span class="font-semibold">Síndrome</span> = apresentação clínica. Embora estáveis por longos períodos, as doenças coronarianas crônicas são <span class="font-semibold">frequentemente progressivas</span> e podem desestabilizar a qualquer momento com o desenvolvimento de uma SCA.
              </p>
            </div>
            <div class="grid md:grid-cols-3 gap-4">
              <div class="bg-neutral-900/50 rounded-xl p-5 text-center">
                <div class="text-3xl font-bold text-blue-400 mb-2">6 cenários</div>
                <p class="text-neutral-400 text-sm">Apresentações clínicas da SCC (ESC 2024)</p>
                <button id="btn-cenarios-scc" class="mt-2 px-3 py-1 bg-blue-500/20 border border-blue-500/40 rounded-full text-blue-300 text-xs font-medium hover:bg-blue-500/30 transition-all cursor-pointer">Ver cenários</button>
              </div>
              <div class="bg-neutral-900/50 rounded-xl p-5 text-center">
                <div class="text-3xl font-bold text-cyan-400 mb-2">70%</div>
                <p class="text-neutral-400 text-sm">Dos cateterismos sem DAC obstrutiva (ANOCA)</p>
              </div>
              <div class="bg-neutral-900/50 rounded-xl p-5 text-center">
                <div class="text-3xl font-bold text-blue-400 mb-2">10-15%</div>
                <p class="text-neutral-400 text-sm">Dos pacientes com angina típica</p>
              </div>
            </div>
          </div>
          <div id="cenarios-scc" class="slide-popup hidden">
            <div class="slide-popup-backdrop"></div>
            <div class="slide-popup-content slide-popup-content--wide">
              <button class="slide-popup-close">&times;</button>
              <h4 class="text-blue-300 font-semibold text-center mb-3">6 Cenários Clínicos da SCC — ESC 2024</h4>
              <div class="grid md:grid-cols-2 gap-3">
                <div class="bg-neutral-800/50 border border-blue-500/20 rounded-xl p-3">
                  <p class="text-blue-300 font-medium text-sm mb-1">1. Suspeita de DAC</p>
                  <p class="text-neutral-400 text-xs">Pacientes com sintomas estáveis de angina e/ou dispneia</p>
                </div>
                <div class="bg-neutral-800/50 border border-cyan-500/20 rounded-xl p-3">
                  <p class="text-cyan-300 font-medium text-sm mb-1">2. DAC obstrutiva recém-diagnosticada</p>
                  <p class="text-neutral-400 text-xs">Início de terapia após confirmação diagnóstica</p>
                </div>
                <div class="bg-neutral-800/50 border border-violet-500/20 rounded-xl p-3">
                  <p class="text-violet-300 font-medium text-sm mb-1">3. Sintomas novos ou piora</p>
                  <p class="text-neutral-400 text-xs">Pacientes com DAC conhecida e mudança do padrão sintomático</p>
                </div>
                <div class="bg-neutral-800/50 border border-amber-500/20 rounded-xl p-3">
                  <p class="text-amber-300 font-medium text-sm mb-1">4. Pós-revascularização</p>
                  <p class="text-neutral-400 text-xs">Acompanhamento após ICP ou CABG</p>
                </div>
                <div class="bg-neutral-800/50 border border-green-500/20 rounded-xl p-3">
                  <p class="text-green-300 font-medium text-sm mb-1">5. IC e suspeita de DAC</p>
                  <p class="text-neutral-400 text-xs">Insuficiência cardíaca com etiologia coronariana possível</p>
                </div>
                <div class="bg-neutral-800/50 border border-red-500/20 rounded-xl p-3">
                  <p class="text-red-300 font-medium text-sm mb-1">6. Assintomáticos com DAC incidental</p>
                  <p class="text-neutral-400 text-xs">DAC detectada em screening ou exame por outra indicação</p>
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- Slide 4: Cascata Isquêmica -->
        <section class="slide flex flex-col items-center justify-start md:justify-center h-full px-4 md:px-8 py-6 md:py-8 overflow-y-auto" data-slide="4">
          <div class="max-w-4xl mx-auto w-full">
            <h2 class="text-3xl md:text-4xl font-bold mb-2 text-center bg-gradient-to-r from-blue-300 to-cyan-300 bg-clip-text text-transparent">A Cascata Isquêmica</h2>
            <p class="text-neutral-400 text-center mb-6 text-sm">Por que a perfusão miocárdica detecta isquemia antes dos outros métodos?</p>
            <div class="flex flex-col items-center gap-2 mb-6">
              <!-- Step 1 -->
              <div class="w-full max-w-lg bg-neutral-900/50 border-2 border-violet-500/50 rounded-2xl p-4 text-center">
                <div class="flex items-center justify-center gap-2 mb-1">
                  <span class="px-2 py-0.5 bg-violet-500/20 text-violet-400 text-xs font-bold rounded">1 - MAIS PRECOCE</span>
                </div>
                <p class="text-lg font-bold text-violet-400">Hipoperfusão Miocárdica</p>
                <p class="text-neutral-400 text-xs mt-1">Detectada por: SPECT, PET, RMC perfusão</p>
              </div>
              <!-- Arrow -->
              <svg class="w-6 h-6 text-neutral-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/></svg>
              <!-- Step 2 -->
              <div class="w-full max-w-lg bg-neutral-900/50 border border-blue-500/30 rounded-2xl p-4 text-center">
                <div class="flex items-center justify-center gap-2 mb-1">
                  <span class="px-2 py-0.5 bg-blue-500/20 text-blue-400 text-xs font-bold rounded">2</span>
                </div>
                <p class="text-lg font-bold text-blue-300">Disfunção Diastólica → Alteração da Contratilidade Segmentar</p>
                <p class="text-neutral-400 text-xs mt-1">Detectada por: Eco estresse, RMC dobutamina</p>
              </div>
              <!-- Arrow -->
              <svg class="w-6 h-6 text-neutral-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/></svg>
              <!-- Step 3 -->
              <div class="w-full max-w-lg bg-neutral-900/50 border border-amber-500/30 rounded-2xl p-4 text-center">
                <div class="flex items-center justify-center gap-2 mb-1">
                  <span class="px-2 py-0.5 bg-amber-500/20 text-amber-400 text-xs font-bold rounded">3</span>
                </div>
                <p class="text-lg font-bold text-amber-300">Alterações Eletrocardiográficas</p>
                <p class="text-neutral-400 text-xs mt-1">Detectada por: TE, monitorização</p>
              </div>
              <!-- Arrow -->
              <svg class="w-6 h-6 text-neutral-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/></svg>
              <!-- Step 4 -->
              <div class="w-full max-w-lg bg-neutral-900/50 border border-red-500/30 rounded-2xl p-4 text-center">
                <div class="flex items-center justify-center gap-2 mb-1">
                  <span class="px-2 py-0.5 bg-red-500/20 text-red-400 text-xs font-bold rounded">4</span>
                </div>
                <p class="text-lg font-bold text-red-300">Angina / Sintomas</p>
                <p class="text-neutral-400 text-xs mt-1">Detectada por: Anamnese</p>
              </div>
            </div>
            <div class="p-4 bg-violet-500/10 border border-violet-500/30 rounded-xl">
              <p class="text-violet-400 text-center text-sm">
                A perfusão miocárdica é a <strong>manifestação mais precoce</strong> da cascata isquêmica — base racional da medicina nuclear na detecção de DAC
              </p>
            </div>
          </div>
        </section>

        <!-- Slide 5: Fluxograma - 4 Steps ESC 2024 -->
        <section class="slide flex flex-col items-center justify-start md:justify-center h-full px-4 md:px-8 py-6 md:py-8 overflow-y-auto" data-slide="5">
          <div class="max-w-5xl mx-auto w-full">
            <h2 class="text-3xl md:text-4xl font-bold mb-2 text-center">Manejo Escalonado da SCC Suspeita</h2>
            <p class="text-neutral-400 text-center mb-6 text-sm">Stepwise approach — ESC Guidelines 2024</p>

            <!-- Flowchart -->
            <div class="flex flex-col items-center gap-1">
              <!-- Step 1 -->
              <div class="w-full max-w-3xl bg-gradient-to-r from-blue-500/10 to-blue-600/5 border-2 border-blue-500/40 rounded-2xl p-4">
                <div class="flex items-center gap-4">
                  <div class="w-12 h-12 bg-blue-500/30 rounded-xl flex items-center justify-center flex-shrink-0">
                    <span class="text-xl font-bold text-blue-300">1</span>
                  </div>
                  <div class="flex-1">
                    <h3 class="text-lg font-bold text-blue-300">Avaliação Clínica Inicial</h3>
                    <p class="text-neutral-400 text-sm mt-1">Anamnese &bull; Exame físico &bull; ECG 12D &bull; Laboratório &bull; Rx tórax<sup>a</sup> &bull; PFP<sup>a</sup></p>
                  </div>
                  <div class="flex flex-col gap-1 flex-shrink-0">
                    <span class="px-2 py-0.5 bg-red-500/20 text-red-400 text-xs rounded text-center">SCA? → Emergência</span>
                    <span class="px-2 py-0.5 bg-neutral-800 text-neutral-400 text-xs rounded text-center">Causa não-cardíaca? → Tratar</span>
                  </div>
                </div>
              </div>

              <svg class="w-6 h-8 text-blue-500/50" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/></svg>

              <!-- Step 2 -->
              <div class="w-full max-w-3xl bg-gradient-to-r from-cyan-500/10 to-cyan-600/5 border-2 border-cyan-500/40 rounded-2xl p-4">
                <div class="flex items-center gap-4">
                  <div class="w-12 h-12 bg-cyan-500/30 rounded-xl flex items-center justify-center flex-shrink-0">
                    <span class="text-xl font-bold text-cyan-300">2</span>
                  </div>
                  <div class="flex-1">
                    <h3 class="text-lg font-bold text-cyan-300">Avaliação Complementar</h3>
                    <p class="text-neutral-400 text-sm mt-1">Ecocardiograma repouso &bull; Estimar probabilidade clínica (RF-CL) &bull; TE<sup>b</sup> &bull; CACS<sup>b</sup></p>
                  </div>
                  <div class="flex flex-col gap-1 flex-shrink-0">
                    <span class="px-2 py-0.5 bg-green-500/20 text-green-400 text-xs rounded text-center">≤5%? → Diferir testes</span>
                    <span class="px-2 py-0.5 bg-neutral-800 text-neutral-400 text-xs rounded text-center">Comorbidade grave? → Tratar</span>
                  </div>
                </div>
              </div>

              <svg class="w-6 h-8 text-cyan-500/50" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/></svg>

              <!-- Step 3 -->
              <div class="w-full max-w-3xl bg-gradient-to-r from-violet-500/10 to-violet-600/5 border-2 border-violet-500/40 rounded-2xl p-4">
                <div class="flex items-center gap-4">
                  <div class="w-12 h-12 bg-violet-500/30 rounded-xl flex items-center justify-center flex-shrink-0">
                    <span class="text-xl font-bold text-violet-300">3</span>
                  </div>
                  <div class="flex-1">
                    <h3 class="text-lg font-bold text-violet-300">Confirmação Diagnóstica e Estratificação de Risco</h3>
                    <p class="text-neutral-400 text-sm mt-1">
                      <span class="text-violet-400">Baixa-Mod (>5-50%):</span> AngioTC &nbsp;|&nbsp;
                      <span class="text-violet-400">Mod-Alta (>15-85%):</span> Imagem funcional &nbsp;|&nbsp;
                      <span class="text-violet-400">Muito alta (>85%):</span> ICA + FFR/iFR
                    </p>
                  </div>
                </div>
                <div class="mt-2 ml-16 flex flex-wrap gap-2">
                  <span class="px-2 py-0.5 bg-violet-500/15 text-violet-400 text-xs rounded">SPECT/PET</span>
                  <span class="px-2 py-0.5 bg-violet-500/15 text-violet-400 text-xs rounded">Eco estresse</span>
                  <span class="px-2 py-0.5 bg-violet-500/15 text-violet-400 text-xs rounded">RMC</span>
                  <span class="px-2 py-0.5 bg-violet-500/15 text-violet-400 text-xs rounded">CCTA</span>
                  <span class="px-2 py-0.5 bg-violet-500/15 text-violet-400 text-xs rounded">FFR-CT</span>
                  <span class="px-2 py-0.5 bg-amber-500/15 text-amber-400 text-xs rounded">Considerar ANOCA/INOCA</span>
                </div>
              </div>

              <svg class="w-6 h-8 text-violet-500/50" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/></svg>

              <!-- Step 4 -->
