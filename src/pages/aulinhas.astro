---
import '../styles/global.css'
---

<html lang="pt-BR">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Aulinhas | Laura Ricarte</title>
	</head>
	<body class="min-h-screen bg-zinc-900 text-zinc-100">
		<nav class="p-6">
			<a href="/" class="text-rose-300 hover:text-rose-200 transition-colors">&larr; voltar</a>
		</nav>

		<main class="max-w-3xl mx-auto px-6 pb-16">
			<header class="text-center mb-12">
				<span class="text-4xl mb-4 block">&#127800;</span>
				<h1 class="text-4xl font-bold text-rose-100 mb-2">Aulinhas</h1>
				<p class="text-zinc-400">um cantinho para compartilhar conhecimento</p>
				<div class="mt-4 h-px bg-gradient-to-r from-transparent via-rose-400/50 to-transparent"></div>
			</header>

			<section class="mb-12">
				<h2 class="text-sm uppercase tracking-wider text-rose-300 mb-6 flex items-center gap-2">
					<span>&#127800;</span> aulas disponíveis
				</h2>

				<div class="space-y-4">
					<a href="/aulinhas/choque-cardiogenico" class="block">
						<article class="bg-zinc-800/50 border border-zinc-700/50 rounded-xl p-6 hover:border-red-400/50 hover:bg-zinc-800/70 transition-all group">
							<div class="flex items-start justify-between">
								<div>
									<h3 class="text-lg font-medium text-rose-50 mb-1 group-hover:text-red-300 transition-colors">Choque Cardiogênico</h3>
									<p class="text-zinc-400 text-sm">Avaliação e manejo baseado em evidências - ACC 2025 e NEJM 2026</p>
									<p class="text-zinc-500 text-xs mt-2">38 slides interativos</p>
								</div>
								<span class="text-xs bg-red-500/20 text-red-400 px-2 py-1 rounded-full">cardiologia</span>
							</div>
						</article>
					</a>
				</div>
			</section>

			<section class="mb-12">
				<h2 class="text-sm uppercase tracking-wider text-zinc-500 mb-6 flex items-center gap-2">
					<span>&#10024;</span> em breve
				</h2>

				<div class="space-y-4">
					<article class="bg-zinc-800/30 border border-zinc-700/30 rounded-xl p-6">
						<div class="flex items-start justify-between">
							<div>
								<h3 class="text-lg font-medium text-zinc-400 mb-1">Mais aulas chegando...</h3>
								<p class="text-zinc-500 text-sm">Fique de olho! Novos conteúdos serão anunciados aqui.</p>
							</div>
							<span class="text-xs bg-zinc-700/50 text-zinc-400 px-2 py-1 rounded-full">em breve</span>
						</div>
					</article>
				</div>
			</section>

			<section class="text-center">
				<p class="text-zinc-500 text-sm">
					&#128140; preparando conteúdos com carinho
				</p>
			</section>
		</main>
	</body>
</html>
